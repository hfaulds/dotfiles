# Ported from config/.config/alacritty.yml
theme = Dracula
font-size = 14
window-padding-x = 2
window-padding-y = 2
maximize = true

# Option acts as Alt, so Alt-b / Alt-f word motions work in zsh
macos-option-as-alt = true
keybind = alt+left=esc:b
keybind = alt+right=esc:f

# Auto-attach tmux like the old alacritty config did; remove to get a plain shell
command = /opt/homebrew/bin/tmux new-session -A
